<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div><h1>Calculo de area</h1></div>
    <nav>
        <div>
            Ola, <strong><%= user.nome &></strong>
            <a href="/logout">Sair</a>
        </div>
    </nav>
    <form method="POST" action="/calculo" id="calculoForm"></form>
    <div>
        <label for="altura">altura</label>
        <input type="number" name="altura" placeholder="altura" id="altura" required>
    </div>
    <div>
        <label for="largura">largura</label>
        <input type="number" name="largura" placeholder="largura" id="largura" required>
    </div>
    <button id="btnCalcular" onclick="calcular()">Calcular</button>
    <div></div><br>
    <div><span>Resultado</span> <span id="data"></span></div>

    <script>
        const alturaF = parseFloat(document.getElementById("altura").value)
        const larguraF = parseFloat(document.getElementById("largura").value)

        const payload = {
            altura : alturaF,
            largura : larguraF
        }

        try{
            const res = await fetch('/calcular', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify(payload)
            })
            const json = await res.json()
            if (!json.sucess) {
                alert('Erro' + json.error) 
                return
            }
            const d = json.data
            document.getElementById('data').textContent = d.toString()
        }
        catch (err){
            alert(err)
        }
        finally{
        
        }
    </script>
</body>
</html>